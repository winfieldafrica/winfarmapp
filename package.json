{
  "name": "winfield",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --filter=./apps/* --filter=./packages/* run build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && vitest run",
    "check:db-baseline": "node scripts/check-db-baseline.mjs",
    "db:migrate": "node scripts/not-yet.mjs db:migrate M1",
    "db:test": "node scripts/not-yet.mjs db:test M1",
    "e2e": "node scripts/not-yet.mjs e2e M12",
    "bootstrap:admin": "node scripts/not-yet.mjs bootstrap:admin M2",
    "build:packages": "pnpm --filter \"./packages/*\" run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
