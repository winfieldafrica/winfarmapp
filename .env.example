# Copy to .env for local development:  cp .env.example .env
# Every value below is a DUMMY. Never commit a real value. Production and staging values live only in the
# host's secret manager, with a different value per environment (setup guide Part 6.3).

# ───────── Secrets: names exactly as setup guide Part 6.3 ─────────
# Database connection strings, one per role. The app roles get LOGIN + passwords locally in M1.
DATABASE_URL_API=postgres://app_api:dummy@localhost:5432/winfield
DATABASE_URL_ENGINE=postgres://app_engine:dummy@localhost:5432/winfield
DATABASE_URL_INGEST=postgres://app_ingest:dummy@localhost:5432/winfield
DATABASE_URL_AUTH=postgres://app_auth:dummy@localhost:5432/winfield
# Migration owner. Used ONLY by `pnpm db:migrate` / deploy migrations, never by a running service.
DATABASE_URL_MIGRATE=postgres://postgres:local-dev-only@localhost:5432/winfield
REDIS_URL=redis://localhost:6379
JWT_ACCESS_PRIVATE_KEY=dummy-not-a-real-key
JWT_ACCESS_PUBLIC_KEY=dummy-not-a-real-key
# The matching public key is built into the mobile app (not a secret, not listed here).
ENTITLEMENT_PRIVATE_KEY=dummy-not-a-real-key
FIELD_ENCRYPTION_KEY=dummy-not-a-real-key
S3_BUCKET=winfield-local-media
S3_ACCESS_KEY=dummy-access-key
S3_SECRET_KEY=dummy-secret-key
S3_REGION=us-east-1
SMS_PROVIDER=console
SMS_API_KEY=dummy
SMS_SENDER_ID=WINFIELD
EMAIL_API_KEY=dummy
EMAIL_FROM=no-reply@example.invalid
EXPO_ACCESS_TOKEN=dummy
ERROR_TRACKING_DSN=
APP_BASE_URL=http://localhost:8081
API_BASE_URL=http://localhost:4000
CONSOLE_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ───────── Non-secret configuration (added by the build; recorded in docs/assumptions.md) ─────────
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
INGEST_PORT=4100
WORKER_HEALTH_PORT=4200
CONSOLE_PORT=3000
# S3-compatible endpoint for local/non-AWS storage. Leave empty for AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Malware scanner (ClamAV) used by the worker from M5.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
